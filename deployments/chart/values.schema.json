{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/caas-team/GoKubeDownscaler/deployments/chart/values.schema.json",
  "title": "go-kube-downscaler Helm values",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
	"stringMap": {
	  "type": "object",
	  "additionalProperties": { "type": "string" }
	},
	"probe": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"failureThreshold": { "type": "integer", "minimum": 1 },
		"initialDelaySeconds": { "type": "integer", "minimum": 0 },
		"periodSeconds": { "type": "integer", "minimum": 1 },
		"timeoutSeconds": { "type": "integer", "minimum": 1 },
		"successThreshold": { "type": "integer", "minimum": 1 }
	  },
	  "required": [
		"enabled",
		"failureThreshold",
		"initialDelaySeconds",
		"periodSeconds",
		"timeoutSeconds",
		"successThreshold"
	  ]
	},
	"image": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"repository": { "type": "string" },
		"pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
		"tag": { "type": "string" }
	  },
	  "required": ["repository", "pullPolicy", "tag"]
	},
	"resources": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"limits": { "$ref": "#/$defs/resourceList" },
		"requests": { "$ref": "#/$defs/resourceList" }
	  }
	},
	"resourceList": {
	  "type": "object",
	  "additionalProperties": { "type": ["string", "integer", "number"] },
	  "properties": {
		"cpu": { "type": ["string", "integer", "number"] },
		"memory": { "type": ["string", "integer", "number"] },
		"ephemeral-storage": { "type": ["string", "integer", "number"] }
	  }
	},
	"envVar": {
	  "type": "object",
	  "additionalProperties": true,
	  "properties": {
		"name": { "type": "string" },
		"value": { "type": "string" },
		"valueFrom": { "type": "object", "additionalProperties": true }
	  },
	  "required": ["name"]
	},
	"imagePullSecret": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"name": { "type": "string" }
	  },
	  "required": ["name"]
	},
	"toleration": {
	  "type": "object",
	  "additionalProperties": true
	},
	"affinity": {
	  "type": "object",
	  "additionalProperties": true
	},
	"seccompProfile": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"type": {
		  "type": "string",
		  "enum": ["RuntimeDefault", "Localhost", "Unconfined"]
		},
		"localhostProfile": { "type": "string" }
	  },
	  "required": ["type"]
	},
	"seLinuxOptions": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"level": { "type": "string" },
		"role": { "type": "string" },
		"type": { "type": "string" },
		"user": { "type": "string" }
	  }
	},
	"appArmorProfile": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"type": {
		  "type": "string",
		  "enum": ["RuntimeDefault", "Localhost", "Unconfined"]
		},
		"localhostProfile": { "type": "string" }
	  },
	  "required": ["type"]
	},
	"windowsSecurityContextOptions": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"gmsaCredentialSpec": { "type": "string" },
		"gmsaCredentialSpecName": { "type": "string" },
		"hostProcess": { "type": "boolean" },
		"runAsUserName": { "type": "string" }
	  }
	},
	"containerSecurityContext": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"readOnlyRootFilesystem": { "type": "boolean" },
		"allowPrivilegeEscalation": { "type": "boolean" },
		"privileged": { "type": "boolean" },
		"runAsGroup": { "type": "integer" },
		"runAsNonRoot": { "type": "boolean" },
		"runAsUser": { "type": "integer" },
		"procMount": { "type": "string", "enum": ["Default", "Unmasked"] },
		"capabilities": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"add": {
			  "type": "array",
			  "items": { "type": "string" }
			},
			"drop": {
			  "type": "array",
			  "items": { "type": "string" }
			}
		  }
		},
		"seccompProfile": { "$ref": "#/$defs/seccompProfile" },
		"seLinuxOptions": { "$ref": "#/$defs/seLinuxOptions" },
		"appArmorProfile": { "$ref": "#/$defs/appArmorProfile" },
		"windowsOptions": { "$ref": "#/$defs/windowsSecurityContextOptions" }
	  }
	},
	"secretTemplate": {
	  "type": "object",
	  "additionalProperties": true
	},
	"podDisruptionBudgetValue": {
	  "oneOf": [
		{ "type": "integer", "minimum": 0 },
		{ "type": "string", "pattern": "^(|[0-9]+%?)$" }
	  ]
	},
	"podDisruptionBudget": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"minAvailable": { "$ref": "#/$defs/podDisruptionBudgetValue" },
		"maxUnavailable": { "$ref": "#/$defs/podDisruptionBudgetValue" }
	  },
	  "not": {
		"allOf": [
		  {
			"required": ["minAvailable"],
			"properties": {
			  "minAvailable": { "not": { "const": "" } }
			}
		  },
		  {
			"required": ["maxUnavailable"],
			"properties": {
			  "maxUnavailable": { "not": { "const": "" } }
			}
		  }
		]
	  }
	}
  },
  "properties": {
	"global": { "type": "object" },
	"enabled": { "type": "boolean" },
	"replicaCount": { "type": "integer", "minimum": 0 },
	"image": { "$ref": "#/$defs/image" },
	"imagePullSecrets": {
	  "type": "array",
	  "items": { "$ref": "#/$defs/imagePullSecret" }
	},
	"arguments": {
	  "type": ["array", "null"],
	  "items": { "type": "string" }
	},
	"extraArguments": {
	  "type": ["array", "null"],
	  "items": { "type": "string" }
	},
	"includedResources": {
	  "type": "array",
	  "items": {
		"type": "string",
		"enum": [
		  "deployments",
		  "statefulsets",
		  "daemonsets",
		  "rollouts",
		  "horizontalpodautoscalers",
		  "jobs",
		  "cronjobs",
		  "scaledobjects",
		  "stacks",
		  "prometheuses",
		  "poddisruptionbudgets",
		  "autoscalingrunnersets",
		  "postgresqls",
		  "mongodbcommunities",
		  "cnpgclusters",
		  "mariadbs",
		  "kafkaconnects",
		  "kafkamirrormaker2s",
		  "kafkabridges",
		  "services",
		  "awselbservices",
		  "awsnlbservices",
		  "ingresses",
		  "gateways",
		  "advancedstatefulsets",
		  "clonesets",
		  "advancedcronjobs",
		  "broadcastjobs",
		  "imagepulljobs",
		  "advanceddaemonsets"
		]
	  }
	},
	"fullnameOverride": { "type": "string" },
	"nameOverride": { "type": "string" },
	"constrainedNamespaces": {
	  "type": "array",
	  "items": { "type": "string" }
	},
	"serviceAccount": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"create": { "type": "boolean" },
		"annotations": { "$ref": "#/$defs/stringMap" },
		"name": { "type": "string" }
	  },
	  "required": ["create", "annotations", "name"]
	},
	"priorityClassName": { "type": "string" },
	"podSecurityContext": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"runAsGroup": { "type": "integer" },
		"runAsNonRoot": { "type": "boolean" },
		"runAsUser": { "type": "integer" },
		"fsGroup": { "type": "integer" },
		"supplementalGroups": {
		  "type": "array",
		  "items": { "type": "integer" }
		},
		"fsGroupChangePolicy": { "type": "string", "enum": ["OnRootMismatch", "Always"] },
		"supplementalGroupsPolicy": { "type": "string", "enum": ["Merge", "Strict"] },
		"seLinuxChangePolicy": { "type": "string", "enum": ["Recursive", "MountOption"] },
		"sysctls": {
		  "type": "array",
		  "items": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
			  "name": { "type": "string" },
			  "value": { "type": "string" }
			},
			"required": ["name", "value"]
		  }
		},
		"seccompProfile": { "$ref": "#/$defs/seccompProfile" },
		"seLinuxOptions": { "$ref": "#/$defs/seLinuxOptions" },
		"appArmorProfile": { "$ref": "#/$defs/appArmorProfile" },
		"windowsOptions": { "$ref": "#/$defs/windowsSecurityContextOptions" }
	  }
	},
	"securityContext": { "$ref": "#/$defs/containerSecurityContext" },
	"healthProbes": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"readinessProbe": { "$ref": "#/$defs/probe" },
		"livenessProbe": { "$ref": "#/$defs/probe" },
		"startupProbe": { "$ref": "#/$defs/probe" }
	  },
	  "required": ["readinessProbe", "livenessProbe", "startupProbe"]
	},
	"resources": { "$ref": "#/$defs/resources" },
	"podAnnotations": { "$ref": "#/$defs/stringMap" },
	"podLabels": { "$ref": "#/$defs/stringMap" },
	"extraEnv": {
	  "type": "array",
	  "items": { "$ref": "#/$defs/envVar" }
	},
	"nodeSelector": { "$ref": "#/$defs/stringMap" },
	"tolerations": {
	  "type": "array",
	  "items": { "$ref": "#/$defs/toleration" }
	},
	"affinity": { "$ref": "#/$defs/affinity" },
	"excludedNamespaces": {
	  "type": "array",
	  "items": { "type": "string" }
	},
	"configMap": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"name": { "type": "string" },
		"extraConfig": { "type": "string" }
	  },
	  "required": ["name", "extraConfig"]
	},
	"forceRestartOnConfigChange": { "type": "boolean" },
	"podDisruptionBudget": { "$ref": "#/$defs/podDisruptionBudget" },
	"deployExtraResources": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"gatewayClass": { "type": "boolean" },
		"ingressClass": { "type": "boolean" }
	  },
	  "required": ["gatewayClass", "ingressClass"]
	},
	"annotationsCompliance": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"mutateUnauthorizedAnnotationsAddition": { "type": "boolean" },
		"failurePolicy": { "type": "string", "enum": ["Fail", "Ignore"] },
		"validationActions": {
		  "type": "array",
		  "minItems": 1,
		  "maxItems": 3,
		  "uniqueItems": true,
		  "items": { "type": "string", "enum": ["Audit", "Warn", "Deny"] }
		},
		"authorizedNamespacesToServiceAccountsRegex": { "$ref": "#/$defs/stringMap" },
		"authorizedUsersRegex": {
		  "type": "array",
		  "maxItems": 60,
		  "uniqueItems": true,
		  "items": { "type": "string" }
		},
		"authorizedGroupsRegex": {
		  "type": "array",
		  "maxItems": 60,
		  "uniqueItems": true,
		  "items": { "type": "string" }
		},
		"onWorkloads": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"preventRemoval": { "type": "boolean" }
		  },
		  "required": ["enabled", "preventRemoval"]
		},
		"onNamespace": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"preventRemoval": { "type": "boolean" }
		  },
		  "required": ["enabled", "preventRemoval"]
		}
	  },
	  "required": [
		"mutateUnauthorizedAnnotationsAddition",
		"validationActions",
		"authorizedNamespacesToServiceAccountsRegex",
		"authorizedUsersRegex",
		"authorizedGroupsRegex",
		"onWorkloads",
		"onNamespace"
	  ]
	},
	"webhookController": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"image": { "$ref": "#/$defs/image" },
		"replicaCount": { "type": "integer", "minimum": 0 },
		"priorityClassName": { "type": "string" },
		"serviceAccount": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"create": { "type": "boolean" },
			"annotations": { "$ref": "#/$defs/stringMap" },
			"name": { "type": "string" }
		  },
		  "required": ["create", "annotations", "name"]
		},
		"extraArguments": {
		  "type": ["array", "null"],
		  "items": { "type": "string" }
		},
		"imagePullSecrets": {
		  "type": "array",
		  "items": { "$ref": "#/$defs/imagePullSecret" }
		},
		"podAnnotations": { "$ref": "#/$defs/stringMap" },
		"podLabels": { "$ref": "#/$defs/stringMap" },
		"extraEnv": {
		  "type": "array",
		  "items": { "$ref": "#/$defs/envVar" }
		},
		"healthProbes": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"readinessProbe": { "$ref": "#/$defs/probe" },
			"livenessProbe": { "$ref": "#/$defs/probe" },
			"startupProbe": { "$ref": "#/$defs/probe" }
		  },
		  "required": ["readinessProbe", "livenessProbe", "startupProbe"]
		},
		"resources": { "$ref": "#/$defs/resources" },
		"securityContext": { "$ref": "#/$defs/containerSecurityContext" },
		"nodeSelector": { "$ref": "#/$defs/stringMap" },
		"tolerations": {
		  "type": "array",
		  "items": { "$ref": "#/$defs/toleration" }
		},
		"affinity": { "$ref": "#/$defs/affinity" },
		"mutatingWebhookConfiguration": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
			"failurePolicy": { "type": "string", "enum": ["Ignore", "Fail"] }
		  },
		  "required": ["timeoutSeconds", "failurePolicy"]
		},
		"podDisruptionBudget": { "$ref": "#/$defs/podDisruptionBudget" },
		"clusterDomain": { "type": "string" },
		"certManager": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"duration": { "type": "string" },
			"renewBefore": { "type": "string" },
			"secretTemplate": { "$ref": "#/$defs/secretTemplate" },
			"ca": {
			  "type": "object",
			  "additionalProperties": false,
			  "properties": {
				"generate": { "type": "boolean" },
				"secretName": { "type": "string" }
			  },
			  "required": ["generate", "secretName"]
			},
			"issuer": {
			  "type": "object",
			  "additionalProperties": false,
			  "properties": {
				"generate": { "type": "boolean" },
				"name": { "type": "string" },
				"kind": { "type": "string" },
				"group": { "type": "string" }
			  },
			  "required": ["generate", "name", "kind", "group"]
			}
		  },
		  "required": ["enabled", "duration", "renewBefore", "secretTemplate", "ca", "issuer"]
		},
		"podMonitor": {
		  "type": "object",
		  "additionalProperties": false,
		  "properties": {
			"enabled": { "type": "boolean" },
			"interval": { "type": "string" },
			"scrapeTimeout": { "type": "string" },
			"namespace": { "type": "string" },
			"additionalLabels": { "$ref": "#/$defs/stringMap" },
			"relabelings": {
			  "type": "array",
			  "items": { "type": "object", "additionalProperties": true }
			},
			"metricRelabelings": {
			  "type": "array",
			  "items": { "type": "object", "additionalProperties": true }
			}
		  },
		  "required": ["enabled", "interval", "scrapeTimeout", "namespace", "additionalLabels", "relabelings", "metricRelabelings"]
		}
	  },
	  "required": [
		"enabled",
		"image",
		"replicaCount",
		"priorityClassName",
		"serviceAccount",
		"podAnnotations",
		"podLabels",
		"extraEnv",
		"healthProbes",
		"resources",
		"securityContext",
		"nodeSelector",
		"tolerations",
		"affinity",
		"mutatingWebhookConfiguration",
		"podDisruptionBudget",
		"clusterDomain",
		"certManager",
		"podMonitor"
	  ]
	},
	"podMonitor": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" },
		"interval": { "type": "string" },
		"scrapeTimeout": { "type": "string" },
		"namespace": { "type": "string" },
		"additionalLabels": { "$ref": "#/$defs/stringMap" },
		"relabelings": {
		  "type": "array",
		  "items": { "type": "object", "additionalProperties": true }
		},
		"metricRelabelings": {
		  "type": "array",
		  "items": { "type": "object", "additionalProperties": true }
		}
	  },
	  "required": ["enabled", "interval", "scrapeTimeout", "namespace", "additionalLabels", "relabelings", "metricRelabelings"]
	},
	"metrics": {
	  "type": "object",
	  "additionalProperties": false,
	  "properties": {
		"enabled": { "type": "boolean" }
	  },
	  "required": ["enabled"]
	}
  },
  "required": []
}


